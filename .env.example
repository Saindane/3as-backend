# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:Admin@localhost:5432/as3_db

# ── JWT ───────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────
# Use * for local development (allows all origins)
# For production, list your actual domains:
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=*

# ── OTP ───────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=3ASCMX

# ── AWS S3 (payment screenshots) ──────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_BUCKET_NAME=3as-payments
AWS_REGION=ap-south-1

# ── Firebase FCM ──────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ── App ───────────────────────────────────────────
APP_NAME=3As Complex API
DEBUG=true
